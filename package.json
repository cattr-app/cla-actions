{
  "name": "@cattr/cla-actions",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Actions automation for Cattr Contributor License Agreements",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js --legal-comments=none",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build && git diff --exit-code -- dist/index.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lefthook": "^2.1.14",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
