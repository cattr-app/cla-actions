{
  "name": "@cattr/cla-actions",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Actions automation for Cattr Contributor License Agreements",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node24 --outfile=dist/index.js --legal-comments=none",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "verify": "pnpm check && pnpm build && git diff --exit-code -- dist/index.js"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "lefthook": "^2.1.14",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
